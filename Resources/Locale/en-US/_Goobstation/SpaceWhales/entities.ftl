ent-SpaceLeviathan = space leviathan
    .desc = When space becomes too quiet, there is no hope, no escape, only this.
    .suffix = persistent boss

ent-SpaceLeviathanDebug = space leviathan
    .desc = { ent-SpaceLeviathan.desc }
    .suffix = admin spawn

ent-SpaceWhaleSegment = space leviathan segment
    .desc = A massive section of the leviathan's body.
    .suffix = do not spawn

ent-LeviathanRib = leviathan rib
    .desc = A huge curved bone from a space leviathan's tail plate. Dark, heavy, and still warm.

ent-LeviathanHeart = leviathan heart
    .desc = A huge pulsing organ from a cosmic predator. A concentrated reserve of life churns inside.

ent-LeviathanStomach = leviathan stomach
    .desc = A sack of dense black flesh wrapped in veins. Concentrated polytrinic acid sloshes inside.

ent-LeviathanBrain = leviathan brain
    .desc = Dark brain tissue with deep folds. Faint violet sparks crawl across its surface.
